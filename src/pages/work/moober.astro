---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import Foot from '../../components/Foot.astro';
import { projects } from '../../data/projects';
import before from '../../assets/moober/moober-search-before.png';
import after from '../../assets/moober/moober-search-results.png';
import resultsCrop from '../../assets/moober/moober-search-results-crop.png';
import trip from '../../assets/moober/moober-trip-details.png';
import mobileResults from '../../assets/moober/mobile-results.png';
import mobileTrip from '../../assets/moober/mobile-trip.png';
import mobilePost from '../../assets/moober/mobile-post.png';
import tierDirect from '../../assets/moober/tier-direct.png';
import tierRoute from '../../assets/moober/tier-route.png';
import tierNearby from '../../assets/moober/tier-nearby.png';
import team from '../../assets/moober/team.jpeg';
import sf from '../../assets/moober/sf.jpeg';

const p = projects.find((x) => x.slug === 'moober')!;
const shots = { widths: [800, 1200, 1600, 2400], sizes: '(min-width: 1024px) 720px, 100vw', quality: 88 };
const index = [['overview', 'Overview'], ['solution', 'Solution'], ['problem', 'Problem'], ['ideas', 'Explorations'], ['constraint', 'Constraint'], ['how', 'How it works'], ['takeaways', 'Takeaways'], ['team', 'Team']];
// 100 listed rides, 44 of them empty: a fixed scatter, so the grid reads as data rather than a block
const empty = new Set([2, 5, 7, 11, 13, 16, 19, 21, 24, 28, 30, 33, 35, 38, 41, 42, 46, 49, 50, 53, 56, 58, 61, 64, 65, 68, 71, 73, 76, 79, 80, 83, 85, 87, 90, 92, 94, 97, 98, 15, 26, 44, 59, 74]);
const rides = Array.from({ length: 100 }, (_, i) => empty.has(i));
// the rider's side: the part of the results screen each feature lives in (x, y, w, h as fractions of the screen)
const features = [
  { r: [0.1967, 0.3187, 0.2767, 0.0328], title: 'Radius slider', text: 'Riders widen the net themselves, up to 30 miles.' },
  { r: [0.7233, 0.3187, 0.08, 0.0328], title: 'Result count', text: 'How many rides fit, across all three tiers.' },
  { r: [0.1967, 0.4381, 0.1983, 0.0351], title: 'Tier badges', text: 'Every result says what kind of match it is.' },
  { r: [0.2227, 0.8833, 0.319, 0.0366], title: 'The whole route', text: "Each card shows the driver's path and where the rider fits on it." },
];
// callouts on the results screen: the exact point each one points at (fractions of the cropped 1980 x 1964 screen),
// which margin it sits in, and how far down that margin
const callouts = [
  { at: [0.012, 0.2775], side: 'l', y: 0.16 },
  { at: [0.99, 0.2775], side: 'r', y: 0.24 },
  { at: [0.012, 0.4089], side: 'l', y: 0.46 },
  { at: [0.6, 0.8926], side: 'r', y: 0.82 },
];
// the result card for each tier, exported from the Moober UI
const tiers = [
  { title: 'Direct match', shot: tierDirect, alt: 'A Direct result: Davis, CA to Fresno, CA, Friday March 8 at noon, $15, two of four seats taken.', text: "Going exactly where the rider is going. This is all the old search could show." },
  { title: 'On your route', shot: tierRoute, alt: "An On your route result: Davis, CA to Los Angeles, CA with a blue stop partway along the route, $15.", text: "Headed somewhere else, like LA, but passing through Fresno, within how far the driver is willing to detour." },
  { title: 'Nearby', shot: tierNearby, alt: 'A Nearby result: Davis, CA to Clovis, CA, $15, with a footer reading 4.2 mi from Fresno, you handle last mile.', text: "Ends close by, and the card says exactly how far, so the rider decides before booking." },
];
---
<Base title="Moober: tiered search, a case study by Ian Kim" description="Nearly half of Moober's rides drove empty while riders searched and saw nothing. I redesigned how the platform matches riders to drivers.">
  <!-- first screen: everything you need to know, cover included -->
  <section class="cs-hero rel">
    <Bar current="work" crumb="Moober" />
    <div class="cs-hero__body grid">
      <div class="cs-hero__head">
        <p class="label enter" style="--i: 1">Moober, tiered search</p>
        <h1 class="words" style="--wd: 250ms">Finding rides that were already there</h1>
      </div>
      <figure class="cs-cover" data-slug={p.slug} style="view-transition-name: cover">
        <Image src={p.cover} alt={p.alt} widths={[800, 1200, 1600, p.cover.width]} sizes="(min-width: 1024px) 58vw, 100vw" quality={86} loading="eager" fetchpriority="high" />
      </figure>
      <div class="cs-hero__meta">
        <p class="cs-lede reveal" style="--i: 3">Nearly half of Moober's rides drove empty while riders who wanted those seats searched, saw nothing, and left. I redesigned how the platform matches riders to drivers.</p>
        <dl class="cs-info reveal" style="--i: 4">
          <div><dt class="label">Role</dt><dd>Product Designer</dd></div>
          <div><dt class="label">Timeline</dt><dd>Spring 2026</dd></div>
          <div class="cs-info__wide"><dt class="label">Team</dt><dd>2 PMs, 1 PD (me), 1 GD, 1 PMM, 4 SWEs</dd></div>
        </dl>
        <a class="cta reveal" style="--i: 5" href="https://mooberdavis.com/" target="_blank" rel="noopener">
          <span>Visit Moober</span><span class="arrow">&nearr;&#65038;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- the framework: a quiet index at the margin, one centred reading column. Everything is there to read at once;
       the only motion in the body is the before and after. -->
  <div class="cs grid" data-light="quiet">
    <nav class="cs-index" aria-label="Sections">
      <a class="cs-index__back mono" href="/">&larr;&#65038; Work</a>
      <ul>{index.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ul>
    </nav>

    <!-- visual first: every beat is a label, a short title, a sentence at most, and one panel that carries it.
         Panels animate once as they arrive (data-play); with reduced motion they simply show their end state. -->
    <main class="cs-col">
      <section class="sec" id="overview">
        <p class="sec__label">Overview</p>
        <h2>A rideshare app that couldn't connect its own users</h2>
        <p class="lead">Moober is UC Davis's student-only rideshare, used by 2,000+ students. I redesigned the search that matches riders with drivers.</p>
        <dl class="facts">
          <div><dt class="label">Problem</dt><dd>44% of rides drove empty while riders saw nothing.</dd></div>
          <div><dt class="label">Solution</dt><dd>Search follows the whole route and sorts rides into three tiers.</dd></div>
          <div><dt class="label">Status</dt><dd>Designed, handed off, and in build.</dd></div>
        </dl>
        <!-- the result, on both screens: desktop results with the phone laid over its corner -->
        <figure class="panel duo" data-play>
          <div class="duo__main"><Image src={after} alt="The tiered search results for Davis to Fresno on desktop." {...shots} /></div>
          <div class="duo__phone"><Image src={mobileResults} alt="The same tiered results on a phone." widths={[300, 520, 780]} sizes="(min-width: 1024px) 220px, 30vw" /></div>
        </figure>
      </section>

      <section class="sec" id="solution">
        <p class="sec__label">Solution</p>
        <h2>Match on the whole route, not just the city.</h2>
        <!-- before and after: pinned, the result wipes across the empty search as you scroll -->
        <div class="compare" data-compare>
          <div class="compare__pin">
            <div class="panel compare__panel">
              <div class="compare__frame">
                <Image class="compare__img" src={before} alt="Before: searching Davis to Fresno returns no results." {...shots} />
                <div class="compare__after"><Image class="compare__img" src={after} alt="After: the same search returns rides along the route, sorted into tiers." {...shots} /></div>
                <i class="compare__line" aria-hidden="true"></i>
              </div>
            </div>
            <div class="compare__caps">
              <p class="compare__cap compare__cap--before"><span class="label label--accent">Before</span> Davis to Fresno. No rides found.</p>
              <p class="compare__cap compare__cap--after"><span class="label label--accent">After</span> The same search, sorted into tiers.</p>
            </div>
          </div>
        </div>

        <h3 class="sub">Three honest tiers</h3>
        <p class="sub__lead">Best match first, and every card says what kind of match it is.</p>
        <ol class="tierlist" data-play>
          {tiers.map((t, i) => (
            <li class="tierrow" style={`--i: ${i}`}>
              <div class="tierrow__text">
                <p class="label label--accent">Tier 0{i + 1}</p>
                <h4>{t.title}</h4>
                <p>{t.text}</p>
              </div>
              <Image class="tierrow__shot" src={t.shot} alt={t.alt} widths={[600, 1000, 1400]} sizes="(min-width: 900px) 560px, 100vw" />
            </li>
          ))}
        </ol>
      </section>

      <section class="sec" id="problem">
        <p class="sec__label">Problem</p>
        <h2>It wasn't a supply problem. It was a search problem.</h2>
        <!-- 100 listed rides; the empty ones light up as the panel arrives -->
        <figure class="panel rides" data-play>
          <div class="rides__grid" aria-hidden="true">{rides.map((e, i) => <i class={e ? 'is-empty' : undefined} style={`--i: ${i}`} />)}</div>
          <figcaption class="rides__key">
            <p class="rides__big">44%</p>
            <p>of listed rides drove with no one in them.</p>
            <p class="label">PostHog, April 2026</p>
          </figcaption>
        </figure>

        <h3 class="sub">Why the seats stayed empty</h3>
        <p class="sub__lead">Search only matched the exact destination city.</p>
        <!-- one ride, Davis to Los Angeles, passing a rider in Fresno who never sees it -->
        <figure class="panel route" data-play>
          <svg class="route__map" viewBox="0 0 640 230" role="img" aria-label="A ride from Davis to Los Angeles passes through Fresno, but the rider searching from Fresno sees no rides.">
            <path class="route__road" d="M40 170 C 190 170, 250 128, 320 128 S 450 170, 600 170"/>
            <path class="route__drive" d="M40 170 C 190 170, 250 128, 320 128 S 450 170, 600 170" pathLength="1"/>
            <circle class="route__stop" cx="40" cy="170" r="6"/><circle class="route__stop route__stop--end" cx="600" cy="170" r="6"/>
            <text class="route__city" x="40" y="204" text-anchor="middle">Davis</text>
            <text class="route__city" x="600" y="204" text-anchor="middle">Los Angeles</text>
            <g class="route__rider"><circle cx="320" cy="128" r="8"/><circle class="route__ring" cx="320" cy="128" r="8"/><text class="route__city" x="320" y="164" text-anchor="middle">Fresno</text></g>
            <g class="route__search" transform="translate(252 30)"><rect width="136" height="56" rx="10"/><text x="16" y="24" class="route__q">Davis → Fresno</text><text x="16" y="43" class="route__none">0 rides found</text></g>
            <circle class="route__car" r="6"/>
          </svg>
        </figure>

        <h3 class="sub">What riders told us</h3>
        <div class="stories" data-play>
          <p style="--i: 0">One student drove all the way to LA to catch a ride that passed his hometown.</p>
          <p style="--i: 1">Another saw one empty screen and assumed the app was dead.</p>
          <p style="--i: 2">For many, one dead end meant buying an Amtrak ticket instead.</p>
        </div>
      </section>

      <section class="sec" id="ideas">
        <p class="sec__label">Explorations</p>
        <h2>Other ideas we weighed</h2>
        <div class="ideas" data-play>
          <figure class="idea" style="--i: 0">
            <svg viewBox="0 0 240 150" aria-hidden="true"><circle class="idea__zone" cx="80" cy="72" r="46"/><circle class="idea__zone" cx="168" cy="80" r="40"/><circle class="idea__dot" cx="66" cy="62" r="4"/><circle class="idea__dot" cx="92" cy="86" r="4"/><circle class="idea__dot" cx="160" cy="70" r="4"/><circle class="idea__dot idea__dot--x" cx="124" cy="124" r="5"/></svg>
            <figcaption><span class="label">Dropped</span><strong>Fixed zones</strong>Close on a map isn't close in traffic.</figcaption>
          </figure>
          <figure class="idea" style="--i: 1">
            <svg viewBox="0 0 240 150" aria-hidden="true"><rect class="idea__card" x="56" y="16" width="128" height="118" rx="10"/><line class="idea__row" x1="72" y1="40" x2="168" y2="40"/><line class="idea__row" x1="72" y1="60" x2="152" y2="60"/><line class="idea__row" x1="72" y1="80" x2="160" y2="80"/><line class="idea__row" x1="72" y1="100" x2="140" y2="100"/><line class="idea__row" x1="72" y1="120" x2="156" y2="120"/></svg>
            <figcaption><span class="label">Dropped</span><strong>Drivers list every city</strong>More work for drivers, and drivers are the supply.</figcaption>
          </figure>
          <figure class="idea idea--kept" style="--i: 2">
            <svg viewBox="0 0 240 150" aria-hidden="true"><rect class="idea__card" x="40" y="30" width="160" height="40" rx="8"/><rect class="idea__card idea__card--blue" x="40" y="80" width="160" height="40" rx="8"/><line class="idea__row" x1="56" y1="50" x2="132" y2="50"/><line class="idea__row idea__row--blue" x1="56" y1="100" x2="148" y2="100"/></svg>
            <figcaption><span class="label label--accent">Shipped alongside</span><strong>Request board</strong>Too slow alone, so it sits next to search.</figcaption>
          </figure>
        </div>
      </section>

      <section class="sec" id="constraint">
        <p class="sec__label">Constraint</p>
        <h2>Only 3,000 free API calls a day</h2>
        <p class="lead">A student startup can't absorb a surprise bill, so every search had to make as few routing calls as possible.</p>
        <!-- what is stored, what is cached, what a check still spends; the count falls from 5 to 2 as it arrives -->
        <figure class="panel calls" data-play>
          <div class="calls__groups">
            <div class="calls__group"><p class="label">Stored once per ride</p><p class="calls__chips"><span class="chip chip--saved" style="--i: 0">Driver start</span><span class="chip chip--saved" style="--i: 1">Driver end</span></p></div>
            <div class="calls__group"><p class="label">Cached per rider</p><p class="calls__chips"><span class="chip chip--saved" style="--i: 2">Rider start</span></p></div>
            <div class="calls__group"><p class="label label--accent">Called per match check</p><p class="calls__chips"><span class="chip chip--spent">Start &rarr;&#65038; Pickup</span><span class="chip chip--spent">Pickup &rarr;&#65038; End</span></p></div>
          </div>
          <div class="calls__sum">
            <p class="calls__big"><span class="calls__from">5</span><span class="calls__to">2</span></p>
            <p class="calls__line">calls per check, once rides are stored and riders cached. Only Tier 2 spends them: about 1,500 checks a day.</p>
          </div>
        </figure>
      </section>

      <section class="sec" id="how">
        <p class="sec__label">How it works</p>
        <h2>What riders see, and what drivers allow.</h2>
        <!-- the results screen with its four new parts pointed out in the margins -->
        <figure class="annotated" data-annotated>
          <div class="annotated__shot">
            <Image src={resultsCrop} alt="The tiered search results screen for Davis to Fresno, with four new parts pointed out." {...shots} sizes="(min-width: 1024px) 600px, 100vw" />
            {callouts.map((c, i) => <b class="annotated__dot" style={`left: ${c.at[0] * 100}%; top: ${c.at[1] * 100}%`} data-dot={i} aria-hidden="true">{i + 1}</b>)}
          </div>
          <svg class="annotated__lines" aria-hidden="true"></svg>
          {features.map((f, i) => (
            <div class={`annotated__note annotated__note--${callouts[i].side}`} style={`--y: ${callouts[i].y}`} data-note={i}>
              <span class="mono">0{i + 1}</span><strong>{f.title}</strong><span>{f.text}</span>
            </div>
          ))}
        </figure>

        <h3 class="sub">Riders confirm their stop</h3>
        <p class="sub__lead">It's checked against the driver's detour limit, so there's no back and forth.</p>
        <figure class="panel duo duo--right" data-play>
          <div class="duo__main"><Image src={trip} alt="Trip details for a Davis to Los Angeles ride via Fresno: pickup, the rider's stop, and drop-off." {...shots} /></div>
          <div class="duo__phone"><Image src={mobileTrip} alt="The same trip on a phone, with the stops along the way opened." widths={[300, 520, 780]} sizes="(min-width: 1024px) 220px, 30vw" /></div>
        </figure>

        <h3 class="sub">Drivers set the limit</h3>
        <p class="sub__lead">5, 15 or 30 minutes. They carry the cost of a detour, so they decide, not riders.</p>
        <figure class="panel duo" data-play>
          <div class="duo__main"><img src="/media/moober-toggle.gif" width="1438" height="820" alt="Posting a new carpool on desktop, turning on pickups along the way and choosing a maximum detour." loading="lazy" /></div>
          <div class="duo__phone"><Image src={mobilePost} alt="Posting a ride on a phone, with the Open to pickups along the way toggle." widths={[300, 520, 780]} sizes="(min-width: 1024px) 220px, 30vw" /></div>
        </figure>
      </section>

      <section class="sec" id="takeaways">
        <p class="sec__label">Takeaways</p>
        <h2>What I took away</h2>
        <ol class="takeaways">
          <li><strong>Constraints are design material.</strong> The call limit, found early with engineering, is why the tiers exist.</li>
          <li><strong>Honesty is a feature.</strong> Showing the mileage gap up front earns more trust than polish.</li>
          <li><strong>What's next.</strong> After launch, I'll watch whether riders who find rides actually book them.</li>
        </ol>
      </section>

      <section class="sec" id="team">
        <p class="sec__label">Team</p>
        <h2>The team behind it</h2>
        <div class="gallery">
          <figure style="--a: 1.5"><Image src={team} alt="The Moober team, ten students standing arm in arm on a tree-lined path." widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 420px, 100vw" /><figcaption class="caption">The Moober team</figcaption></figure>
          <figure style="--a: 0.75"><Image src={sf} alt="A team trip to San Francisco: Moober written in the sand on a beach." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 210px, 50vw" /><figcaption class="caption">A trip to San Francisco</figcaption></figure>
          <figure style="--a: 0.5625"><div class="clip"><video src="/media/moober-reel.mp4#t=0.5" width="720" height="1280" muted loop playsinline preload="auto" data-autoplay aria-label="The team's promo reel"></video></div><figcaption class="caption">Our promo reel</figcaption></figure>
        </div>
      </section>
    </main>
  </div>

  <Foot />
</Base>
