---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import Foot from '../../components/Foot.astro';
import { projects } from '../../data/projects';
import before from '../../assets/moober/moober-search-before.png';
import after from '../../assets/moober/moober-search-results.png';
import trip from '../../assets/moober/moober-trip-details.png';
import mobileTrip from '../../assets/moober/mobile-trip.png';
import mobileResults from '../../assets/moober/mobile-results.png';
import tierDirect from '../../assets/moober/tier-direct.png';
import tierRoute from '../../assets/moober/tier-route.png';
import tierNearby from '../../assets/moober/tier-nearby.png';
import team from '../../assets/moober/team.jpeg';
import sf from '../../assets/moober/sf.jpeg';

const p = projects.find((x) => x.slug === 'moober')!;
const shots = { widths: [800, 1200, 1600, 2400], sizes: '(min-width: 1024px) 720px, 100vw', quality: 88 };
const index = [['overview', 'Overview'], ['problem', 'Problem'], ['research', 'Research'], ['ideate', 'Ideate'], ['decisions', 'Design decisions'], ['solution', 'Solution'], ['takeaways', 'Takeaways']];
// the result card for each tier, exported from the Moober UI
const tiers = [
  { title: 'Direct match', shot: tierDirect, alt: 'A Direct result: Davis, CA to Fresno, CA, Friday March 8 at noon, $15, two of four seats taken.', text: "Going exactly where the rider is going. This is all the old search could show." },
  { title: 'On your route', shot: tierRoute, alt: "An On your route result: Davis, CA to Los Angeles, CA with a blue stop partway along the route, $15.", text: "Headed somewhere else, like LA, but passing through Fresno, within how far the driver is willing to detour." },
  { title: 'Nearby', shot: tierNearby, alt: 'A Nearby result: Davis, CA to Clovis, CA, $15, with a footer reading 4.2 mi from Fresno, you handle last mile.', text: "Ends close by, and the card says exactly how far, so the rider decides before booking." },
];
---
<Base title="Moober: tiered search, a case study by Ian Kim" description="Nearly half of Moober's rides drove empty while riders searched and saw nothing. I redesigned how the platform matches riders to drivers.">
  <!-- first screen: everything you need to know, cover included -->
  <section class="cs-hero rel">
    <Bar current="work" crumb="Moober" />
    <div class="cs-hero__body grid">
      <div class="cs-hero__head">
        <h1 class="words" style="--wd: 150ms">Finding rides that were already there</h1>
      </div>
      <figure class="cs-cover" data-slug={p.slug} style="view-transition-name: cover">
        <Image src={p.cover} alt={p.alt} widths={[800, 1200, 1600, p.cover.width]} sizes="(min-width: 1024px) 58vw, 100vw" quality={86} loading="eager" fetchpriority="high" />
      </figure>
      <div class="cs-hero__meta">
        <p class="cs-lede reveal" style="--i: 3">Redesigning search so riders see every ride headed their way.</p>
        <dl class="cs-info reveal" style="--i: 4">
          <div><dt class="label">Role</dt><dd>Product Designer</dd></div>
          <div><dt class="label">Timeline</dt><dd>Spring 2026</dd></div>
          <div class="cs-info__wide"><dt class="label">Team</dt><dd>2 PMs, 1 PD (me), 1 GD, 1 PMM, 4 SWEs</dd></div>
        </dl>
        <a class="cta reveal" style="--i: 5" href="https://mooberdavis.com/" target="_blank" rel="noopener">
          <span>Visit Moober</span><span class="arrow">&nearr;&#65038;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- the framework: a quiet index at the margin, one centred reading column. Everything is there to read at once;
       the only motion in the body is the before and after. -->
  <div class="cs grid" data-light="quiet">
    <nav class="cs-index" aria-label="Sections">
      <a class="cs-index__back mono" href="/">&larr;&#65038; Work</a>
      <ul>{index.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ul>
    </nav>

    <main class="cs-col">
      <!-- the story in order: context, the problem in a line, a first look at the result, then how we got there.
           Words go in boxes, screens go on plates, and the screens carry the solution on their own. -->
      <!-- overview: only what Moober is, in a few lines -->
      <section class="sec" id="overview">
        <div class="note">
          <p class="sec__label">Overview</p>
          <h2>A rideshare made by students, for students</h2>
          <p>Moober is UC Davis's student-only rideshare, used by 2,000+ students to share rides out of Davis. Drivers post trips with open seats, and riders search by where they're going to book one. I was the only product designer on a team of nine, and the new search is now in build.</p>
        </div>
      </section>

      <!-- problem: the problem stated outright, then what it looked like -->
      <section class="sec" id="problem">
        <div class="note">
          <p class="sec__label">Problem</p>
          <h2>Riders searched, saw nothing, and left.</h2>
          <p>Search only matched a driver's final city. A rider going to Fresno never saw the driver heading to LA straight through Fresno, even with seats open.</p>
        </div>
        <figure class="plate"><Image src={before} alt="Searching Davis to Fresno before the redesign: no rides found." {...shots} /></figure>
      </section>

      <!-- a first look at the result: its own section, left out of the index -->
      <section class="sec" id="peek">
        <div class="note">
          <p class="sec__label">Solution</p>
          <h2>Search that follows the whole route</h2>
          <p>The same search now shows rides going there, rides passing through, and rides ending nearby, sorted into three tiers.</p>
        </div>
        <figure class="plate plate--pair">
          <Image src={after} alt="The redesigned search results for Davis to Fresno on desktop, sorted into tiers." {...shots} />
          <Image class="phone" src={mobileResults} alt="The same search on a phone." widths={[300, 520, 780]} sizes="(min-width: 1024px) 200px, 30vw" />
        </figure>
      </section>

      <!-- research: what the numbers said, what riders said, the insight, then the question -->
      <section class="sec" id="research">
        <div class="note">
          <p class="sec__label">Research</p>
          <h2>Riders weren't missing rides. Search was hiding them.</h2>
          <p>We started with our PostHog analytics, then interviewed riders we recruited through a gift card giveaway.</p>
        </div>
        <div class="cards cards--2">
          <article class="card"><h3>Analytics</h3><p class="stat__big">44%</p><p>of listed rides drove empty in April 2026, while riders were on the app searching.</p></article>
          <article class="card"><h3>Interviews</h3><p>One student drove to LA to catch a ride that passed his hometown. Another saw one empty screen and assumed the app was dead. For many, a dead end meant an Amtrak ticket.</p></article>
          <article class="card card--wide"><h3>Insight</h3><p>Search only matched a driver's final city, so the rides passing through a rider's town never showed up.</p></article>
        </div>
        <div class="hmw">
          <p class="hmw__q">How might we help riders find the rides already passing through their town?</p>
        </div>
      </section>

      <!-- ideate: the ideas we weighed before the route won -->
      <section class="sec" id="ideate">
        <div class="note">
          <p class="sec__label">Ideate</p>
          <h2>Four ways to fill an empty search</h2>
          <p>Before settling on the route, we weighed what each idea asked of drivers, and whether it would actually match riders.</p>
        </div>
        <div class="cards cards--2">
          <article class="card"><p class="tag">Dropped</p><h3>Fixed zones</h3><p>Group cities into zones and match within them. But close on a map isn't close in traffic.</p></article>
          <article class="card"><p class="tag">Dropped</p><h3>Drivers list every city</h3><p>Let drivers add each town they pass. More work for drivers, and drivers are the supply.</p></article>
          <article class="card"><p class="tag">Kept, alongside</p><h3>Request board</h3><p>Riders post where they need to go. Useful, but too slow on its own, so it sits next to search.</p></article>
          <article class="card card--chosen"><p class="tag">Chosen</p><h3>Match the whole route</h3><p>Check whether a driver's route passes near the rider. No extra work for drivers, and it finds the rides that were already there.</p></article>
        </div>
      </section>

      <!-- design decisions: the two calls that shaped the build, each with why and the screen that shows it -->
      <section class="sec" id="decisions">
        <div class="note">
          <p class="sec__label">Design decisions</p>
          <h2>Designing around 3,000 map calls a day</h2>
          <p>Matching on the route meant asking a map service whether each driver passes near the rider. Our free tier allowed 3,000 calls a day, and a student startup can't absorb a surprise bill.</p>
        </div>

        <div class="decision">
          <div class="note">
            <h3>Tiers built around the call budget</h3>
            <p>A full check cost 5 calls. Our TPM stored each ride's start and end and cached the rider's, which brought it to 2, about 1,500 checks a day. I designed the tiers so only one of them spends those calls.</p>
            <p>Direct rides match on the city, with no check. On your route rides are the only ones checked against the map. Nearby rides end close by, and the card says exactly how far, so the rider decides before booking.</p>
          </div>
          <figure class="plate"><div class="tierstack">{tiers.map((t) => <Image src={t.shot} alt={t.alt} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 560px, 80vw" />)}</div></figure>
        </div>

        <div class="decision">
          <div class="note">
            <h3>Drivers set the detour</h3>
            <p>A route match only works if the driver is willing to stop. So drivers opt into pickups along the way and choose a maximum detour of 5, 15 or 30 minutes. They carry the cost, so they decide.</p>
            <p>We ruled out letting riders ask for detours, since every booking would turn into a negotiation.</p>
          </div>
          <figure class="plate"><img src="/media/moober-toggle.gif" width="1438" height="820" alt="Posting a new carpool: the toggle for pickups along the way and the maximum detour." loading="lazy" /></figure>
        </div>
      </section>

      <!-- solution: the final design, before and after, then the trip a rider books -->
      <section class="sec" id="solution">
        <div class="note">
          <p class="sec__label">Solution</p>
          <h2>The same search, now full of rides</h2>
          <p>Davis to Fresno used to return nothing. Now it shows every ride that goes there, passes through, or ends close by.</p>
        </div>
        <!-- before and after: pinned, the result wipes across the empty search as you scroll -->
        <div class="compare" data-compare>
          <div class="compare__pin">
            <div class="plate compare__panel">
              <div class="compare__frame">
                <Image class="compare__img" src={before} alt="Before: searching Davis to Fresno returns no results." {...shots} />
                <div class="compare__after"><Image class="compare__img" src={after} alt="After: the same search returns rides along the route, sorted into tiers." {...shots} /></div>
                <i class="compare__line" aria-hidden="true"></i>
              </div>
            </div>
            <div class="compare__caps">
              <p class="compare__cap compare__cap--before"><span class="label label--accent">Before</span> No rides found.</p>
              <p class="compare__cap compare__cap--after"><span class="label label--accent">After</span> Rides along the route, sorted into tiers.</p>
            </div>
          </div>
        </div>
        <div class="decision">
          <div class="note">
            <h3>Riders see exactly where they'll be picked up and dropped off</h3>
            <p>The trip page lays out the pickup, the rider's own stop along the way and the drop-off, on desktop and on the phone.</p>
          </div>
          <figure class="plate plate--pair">
            <Image src={trip} alt="Trip details for a Davis to Los Angeles ride via Fresno: pickup, the rider's stop, and drop-off." {...shots} />
            <Image class="phone" src={mobileTrip} alt="The same trip on a phone, with the stops along the way opened." widths={[300, 520, 780]} sizes="(min-width: 1024px) 200px, 30vw" />
          </figure>
        </div>
      </section>

      <section class="sec" id="takeaways">
        <div class="note">
          <p class="sec__label">Takeaways</p>
          <h2>What I took away</h2>
        </div>
        <div class="cards cards--3">
          <article class="card"><h3>Constraints are design material.</h3><p>The call limit, found early with engineering, is why the tiers exist.</p></article>
          <article class="card"><h3>Honesty is a feature.</h3><p>Showing the mileage gap up front earns more trust than polish.</p></article>
          <article class="card"><h3>What's next.</h3><p>After launch, I'll watch whether riders who find rides actually book them.</p></article>
        </div>
        <div class="gallery">
          <figure style="--a: 1.5"><Image src={team} alt="The Moober team, ten students standing arm in arm on a tree-lined path." widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 420px, 100vw" /><figcaption class="caption">The Moober team</figcaption></figure>
          <figure style="--a: 0.75"><Image src={sf} alt="A team trip to San Francisco: Moober written in the sand on a beach." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 210px, 50vw" /><figcaption class="caption">A trip to San Francisco</figcaption></figure>
          <figure style="--a: 0.5625"><div class="clip"><video src="/media/moober-reel.mp4#t=0.5" width="720" height="1280" muted loop playsinline preload="auto" data-autoplay aria-label="The team's promo reel"></video></div><figcaption class="caption">Our promo reel</figcaption></figure>
        </div>
      </section>
    </main>
  </div>

  <Foot />
</Base>
