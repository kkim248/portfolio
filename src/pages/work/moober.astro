---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import Foot from '../../components/Foot.astro';
import { projects } from '../../data/projects';
import before from '../../assets/moober/moober-search-before.png';
import after from '../../assets/moober/moober-search-results.png';
import resultsCrop from '../../assets/moober/moober-search-results-crop.png';
import trip from '../../assets/moober/moober-trip-details.png';
import mobileTrip from '../../assets/moober/mobile-trip.png';
import mobileResults from '../../assets/moober/mobile-results.png';
import tierDirect from '../../assets/moober/tier-direct.png';
import tierRoute from '../../assets/moober/tier-route.png';
import tierNearby from '../../assets/moober/tier-nearby.png';
import team from '../../assets/moober/team.jpeg';
import sf from '../../assets/moober/sf.jpeg';

const p = projects.find((x) => x.slug === 'moober')!;
const shots = { widths: [800, 1200, 1600, 2400], sizes: '(min-width: 1024px) 720px, 100vw', quality: 88 };
const index = [['overview', 'Overview'], ['problem', 'Problem'], ['ideas', 'Explorations'], ['constraint', 'Constraint'], ['solution', 'Solution'], ['how', 'How it works'], ['takeaways', 'Takeaways'], ['team', 'Team']];
// the rider's side: the part of the results screen each feature lives in (x, y, w, h as fractions of the screen)
const features = [
  { r: [0.1967, 0.3187, 0.2767, 0.0328], title: 'Radius slider', text: 'Riders widen the net themselves, up to 30 miles.' },
  { r: [0.7233, 0.3187, 0.08, 0.0328], title: 'Result count', text: 'How many rides fit, across all three tiers.' },
  { r: [0.1967, 0.4381, 0.1983, 0.0351], title: 'Tier badges', text: 'Every result says what kind of match it is.' },
  { r: [0.2227, 0.8833, 0.319, 0.0366], title: 'The whole route', text: "Each card shows the driver's path and where the rider fits on it." },
];
// where each numbered marker sits on the cropped results screen (fractions of the 1980 x 1964 screen)
const dots = [[0.012, 0.2775], [0.99, 0.2775], [0.012, 0.4089], [0.6, 0.8926]];
// the result card for each tier, exported from the Moober UI
const tiers = [
  { title: 'Direct match', shot: tierDirect, alt: 'A Direct result: Davis, CA to Fresno, CA, Friday March 8 at noon, $15, two of four seats taken.', text: "Going exactly where the rider is going. This is all the old search could show." },
  { title: 'On your route', shot: tierRoute, alt: "An On your route result: Davis, CA to Los Angeles, CA with a blue stop partway along the route, $15.", text: "Headed somewhere else, like LA, but passing through Fresno, within how far the driver is willing to detour." },
  { title: 'Nearby', shot: tierNearby, alt: 'A Nearby result: Davis, CA to Clovis, CA, $15, with a footer reading 4.2 mi from Fresno, you handle last mile.', text: "Ends close by, and the card says exactly how far, so the rider decides before booking." },
];
---
<Base title="Moober: tiered search, a case study by Ian Kim" description="Nearly half of Moober's rides drove empty while riders searched and saw nothing. I redesigned how the platform matches riders to drivers.">
  <!-- first screen: everything you need to know, cover included -->
  <section class="cs-hero rel">
    <Bar current="work" crumb="Moober" />
    <div class="cs-hero__body grid">
      <div class="cs-hero__head">
        <h1 class="words" style="--wd: 150ms">Finding rides that were already there</h1>
      </div>
      <figure class="cs-cover" data-slug={p.slug} style="view-transition-name: cover">
        <Image src={p.cover} alt={p.alt} widths={[800, 1200, 1600, p.cover.width]} sizes="(min-width: 1024px) 58vw, 100vw" quality={86} loading="eager" fetchpriority="high" />
      </figure>
      <div class="cs-hero__meta">
        <p class="cs-lede reveal" style="--i: 3">Nearly half of Moober's rides drove empty while riders searched and saw nothing. I redesigned how it matches riders to drivers.</p>
        <dl class="cs-info reveal" style="--i: 4">
          <div><dt class="label">Role</dt><dd>Product Designer</dd></div>
          <div><dt class="label">Timeline</dt><dd>Spring 2026</dd></div>
          <div class="cs-info__wide"><dt class="label">Team</dt><dd>2 PMs, 1 PD (me), 1 GD, 1 PMM, 4 SWEs</dd></div>
        </dl>
        <a class="cta reveal" style="--i: 5" href="https://mooberdavis.com/" target="_blank" rel="noopener">
          <span>Visit Moober</span><span class="arrow">&nearr;&#65038;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- the framework: a quiet index at the margin, one centred reading column. Everything is there to read at once;
       the only motion in the body is the before and after. -->
  <div class="cs grid" data-light="quiet">
    <nav class="cs-index" aria-label="Sections">
      <a class="cs-index__back mono" href="/">&larr;&#65038; Work</a>
      <ul>{index.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ul>
    </nav>

    <main class="cs-col">
      <!-- one system for the whole study: every block is a short note, then one visual on a slate plate.
           Every plate is the same size, and holds real screens from the product. Text never goes in a box. -->
      <section class="sec" id="overview">
        <div class="note">
          <p class="sec__label">Overview</p>
          <h2>A rideshare app that couldn't connect its own users</h2>
          <p>Moober is UC Davis's student-only rideshare, used by 2,000+ students. I redesigned its search so it follows each driver's whole route. It's designed, handed off and in build.</p>
        </div>
        <figure class="plate plate--pair">
          <Image src={after} alt="The tiered search results for Davis to Fresno on desktop." {...shots} />
          <Image class="phone" src={mobileResults} alt="The same search on a phone." widths={[300, 520, 780]} sizes="(min-width: 1024px) 200px, 30vw" />
        </figure>
      </section>

      <section class="sec" id="problem">
        <div class="note">
          <p class="sec__label">Problem</p>
          <h2>It wasn't a supply problem. It was a search problem.</h2>
          <p>44% of listed rides drove empty in April 2026. Search only matched the exact destination city, so a ride to LA through Fresno never showed up for anyone going to Fresno.</p>
        </div>
        <figure class="plate">
          <Image src={before} alt="Searching Davis to Fresno before the redesign: no rides found." {...shots} />
        </figure>
        <blockquote class="pull">
          <p>One student drove to LA to catch a ride that passed his hometown.</p>
          <cite class="label">From rider interviews</cite>
        </blockquote>
      </section>

      <section class="sec" id="ideas">
        <div class="note">
          <p class="sec__label">Explorations</p>
          <h2>How might we fill riders' search results?</h2>
          <p>We weighed three other ideas first.</p>
        </div>
        <ol class="cols">
          <li><p class="label">Dropped</p><h3>Fixed zones</h3><p>Close on a map isn't close in traffic.</p></li>
          <li><p class="label">Dropped</p><h3>Drivers list every city</h3><p>More work for drivers, and drivers are the supply.</p></li>
          <li><p class="label">Shipped alongside</p><h3>Request board</h3><p>Too slow alone, so it sits next to search.</p></li>
        </ol>
      </section>

      <section class="sec" id="constraint">
        <div class="note">
          <p class="sec__label">Constraint</p>
          <h2>Only 3,000 free map calls a day</h2>
          <p>A student startup can't absorb a surprise bill. By storing each ride's start and end and caching the rider's, a match check drops from 5 calls to 2, about 1,500 checks a day. Only the On your route tier spends them.</p>
        </div>
      </section>

      <section class="sec" id="solution">
        <div class="note">
          <p class="sec__label">Solution</p>
          <h2>Match on the whole route, not just the city.</h2>
          <p>The same Davis to Fresno search, before and after. Scroll to see it change.</p>
        </div>
        <!-- before and after: pinned, the result wipes across the empty search as you scroll -->
        <div class="compare" data-compare>
          <div class="compare__pin">
            <div class="plate compare__panel">
              <div class="compare__frame">
                <Image class="compare__img" src={before} alt="Before: searching Davis to Fresno returns no results." {...shots} />
                <div class="compare__after"><Image class="compare__img" src={after} alt="After: the same search returns rides along the route, sorted into tiers." {...shots} /></div>
                <i class="compare__line" aria-hidden="true"></i>
              </div>
            </div>
            <div class="compare__caps">
              <p class="compare__cap compare__cap--before"><span class="label label--accent">Before</span> No rides found.</p>
              <p class="compare__cap compare__cap--after"><span class="label label--accent">After</span> Rides along the route, sorted into tiers.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="sec" id="tiers">
        <div class="note">
          <p class="sec__label">Three tiers</p>
          <h2>Best match first, and every card says what kind of match it is.</h2>
          <p>Direct rides go exactly there. On your route rides pass through, within the driver's detour limit. Nearby rides end close, and say exactly how far.</p>
        </div>
        <figure class="plate">
          <div class="stack">
            {tiers.map((t) => <Image src={t.shot} alt={t.alt} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 560px, 80vw" />)}
          </div>
        </figure>
      </section>

      <section class="sec" id="how">
        <div class="note">
          <p class="sec__label">How it works</p>
          <h2>Four new parts on the results screen</h2>
        </div>
        <figure class="plate">
          <div class="marked">
            <Image src={resultsCrop} alt="The tiered search results screen for Davis to Fresno, with four new parts numbered." {...shots} sizes="(min-width: 1024px) 560px, 80vw" />
            {dots.map((d, i) => <b class="marked__dot" style={`left: ${d[0] * 100}%; top: ${d[1] * 100}%`} aria-hidden="true">{i + 1}</b>)}
          </div>
        </figure>
        <ol class="cols cols--4">
          {features.map((f, i) => <li><p class="label">0{i + 1}</p><h3>{f.title}</h3><p>{f.text}</p></li>)}
        </ol>
      </section>

      <section class="sec" id="stop">
        <div class="note">
          <p class="sec__label">Riders</p>
          <h2>Riders confirm their stop on the way.</h2>
          <p>It's checked against the driver's detour limit before they book.</p>
        </div>
        <figure class="plate plate--pair">
          <Image src={trip} alt="Trip details for a Davis to Los Angeles ride via Fresno: pickup, the rider's stop, and drop-off." {...shots} />
          <Image class="phone" src={mobileTrip} alt="The same trip on a phone, with the stops along the way opened." widths={[300, 520, 780]} sizes="(min-width: 1024px) 200px, 30vw" />
        </figure>
      </section>

      <section class="sec" id="drivers">
        <div class="note">
          <p class="sec__label">Drivers</p>
          <h2>Drivers choose how far they'll go.</h2>
          <p>They opt into pickups along the way and set a maximum detour of 5, 15 or 30 minutes. They carry the cost, so they decide. Letting riders ask for detours was ruled out: every booking would turn into a negotiation.</p>
        </div>
        <figure class="plate">
          <img src="/media/moober-toggle.gif" width="1438" height="820" alt="Posting a new carpool: trunk space, seats, pricing, and the toggle for pickups along the way." loading="lazy" />
        </figure>
      </section>

      <section class="sec" id="takeaways">
        <div class="note">
          <p class="sec__label">Takeaways</p>
          <h2>What I took away</h2>
        </div>
        <ol class="cols">
          <li><p class="label">01</p><h3>Constraints are design material.</h3><p>The call limit, found early with engineering, is why the tiers exist.</p></li>
          <li><p class="label">02</p><h3>Honesty is a feature.</h3><p>Showing the mileage gap up front earns more trust than polish.</p></li>
          <li><p class="label">03</p><h3>What's next.</h3><p>After launch, I'll watch whether riders who find rides actually book them.</p></li>
        </ol>
      </section>

      <section class="sec" id="team">
        <div class="note">
          <p class="sec__label">Team</p>
          <h2>The team behind it</h2>
        </div>
        <div class="gallery">
          <figure style="--a: 1.5"><Image src={team} alt="The Moober team, ten students standing arm in arm on a tree-lined path." widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 420px, 100vw" /><figcaption class="caption">The Moober team</figcaption></figure>
          <figure style="--a: 0.75"><Image src={sf} alt="A team trip to San Francisco: Moober written in the sand on a beach." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 210px, 50vw" /><figcaption class="caption">A trip to San Francisco</figcaption></figure>
          <figure style="--a: 0.5625"><div class="clip"><video src="/media/moober-reel.mp4#t=0.5" width="720" height="1280" muted loop playsinline preload="auto" data-autoplay aria-label="The team's promo reel"></video></div><figcaption class="caption">Our promo reel</figcaption></figure>
        </div>
      </section>
    </main>
  </div>

  <Foot />
</Base>
