---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import Foot from '../components/Foot.astro';
// Ian's About frame in Figma (MY-PORTFOLIOOO, "About — type 2 + accents A"), set on the site grid: the photos span
// columns 1 to 6, the first paragraph spans columns 7 to 9 and the second 8 to 10. Heights come from the screen
// (--u, one 672th of it), so the whole composition fits the first view at any width.
import beach from '../assets/about/slate-beach.jpg';
import bridge from '../assets/about/slate-bridge.jpg';
import trail from '../assets/about/slate-trail.jpg';
import group from '../assets/about/slate-group.jpg';
import plant from '../assets/about/plant.png';
const shot = { widths: [400, 700, 1100], sizes: '(min-width: 900px) 45vw, 100vw' };
---
<Base title="About Ian Kim" description="Ian Kim is a designer at UC Davis with an artist's eye for detail.">
  <Bar current="about" crumb="About" parent={{ label: 'Home', href: '/' }} />

  <main class="abx" data-light="soft">
    <!-- the plant is set against the page's right edge, so its stem always leaves the page -->
    <Image class="abx__plant" src={plant} alt="" widths={[600, 1000]} sizes="25vw" />
    <div class="abx__stage grid">
      <div class="abx__photos">
        <figure class="abx__ph abx__ph--beach"><Image src={beach} alt="Ian on the beach at Crissy Field at sunset, the Golden Gate Bridge behind him." {...shot} loading="eager" /></figure>
        <figure class="abx__ph abx__ph--bridge"><Image src={bridge} alt="Friends walking across a bridge toward the city skyline." {...shot} /></figure>
        <figure class="abx__ph abx__ph--trail"><Image src={trail} alt="Two friends on a coastal trail above the ocean." {...shot} /></figure>
        <figure class="abx__ph abx__ph--group"><Image src={group} alt="A group of friends with snowboards on the mountain." {...shot} /></figure>
      </div>
      <div class="abx__words">
      <p class="abx__p abx__p--1">I'm a product designer from San Francisco, studying design at UC Davis. I started out in fine arts, but quickly realized I wanted to use those creative skills to make things people use every day, which led me to product design. Right now I design for Moober and Buzzit, two live apps for Davis students.</p>
      <p class="abx__p abx__p--2">In my free time, I like to go on spontaneous trips with friends, sketch portraits and landscapes, make beats, and find yummy food to eat!</p>
      </div>
      <!-- the marks, drawn on the content box at 1440 (1312 wide, 700 of --u tall) -->
      <svg class="abx__marks" viewBox="0 0 1312 700" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="abx-fade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="704"><stop offset="0" stop-color="var(--pop)" stop-opacity="0"/><stop offset=".06" stop-color="var(--pop)"/><stop offset=".9" stop-color="var(--pop)"/><stop offset="1" stop-color="var(--pop)" stop-opacity="0"/></linearGradient></defs>
        <path class="abx__line" d="M532 28 C 594 -2, 646 56, 641 172 S 632 400, 646 482 C 670 562, 732 604, 772 566 C 810 530, 782 490, 746 512 C 708 536, 726 626, 792 704"/>
        <path class="s" d="M321.6 277.5 A57 57 0 1 1 296.5 247.6"/>
        <ellipse class="s" cx="514" cy="635" rx="140" ry="44" transform="rotate(-12 514 635)"/><circle cx="638" cy="612" r="3.5"/>
      </svg>
    </div>
  </main>

  <Foot />
</Base>
