---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import Foot from '../components/Foot.astro';
// Ian's About frame in Figma (MY-PORTFOLIOOO, "About — type 2 + accents A"): four photos in his slate colouring,
// exported from the frame, two offset paragraphs, the plant, and a few fine blue marks that each touch a photo.
import beach from '../assets/about/slate-beach.jpg';
import bridge from '../assets/about/slate-bridge.jpg';
import trail from '../assets/about/slate-trail.jpg';
import group from '../assets/about/slate-group.jpg';
import plant from '../assets/about/plant.png';
// every piece is placed on the frame's 1440 x 700 stage (frame y 100 to 800), in percent, so the composition scales as one
const at = (x, y, w, h) => `left:${x / 14.4}%; top:${(y - 100) / 7}%; width:${w / 14.4}%; height:${h / 7}%`;
const shot = { widths: [400, 700, 1100], sizes: '(min-width: 900px) 40vw, 100vw' };
---
<Base title="About Ian Kim" description="Ian Kim is a designer at UC Davis with an artist's eye for detail.">
  <Bar current="about" crumb="About" parent={{ label: 'Home', href: '/' }} />

  <main class="abx" data-light="soft">
    <div class="abx__stage">
      <Image class="abx__plant" src={plant} alt="" widths={[600, 1000]} sizes="50vw" style={at(1186, 418, 272, 416)} />
      <figure class="abx__ph abx__ph--beach" style={at(127, 128, 581, 257)}><Image src={beach} alt="Ian on the beach at Crissy Field at sunset, the Golden Gate Bridge behind him." {...shot} loading="eager" /></figure>
      <figure class="abx__ph abx__ph--bridge" style={at(128, 409, 245, 361)}><Image src={bridge} alt="Friends walking across a bridge toward the city skyline." {...shot} /></figure>
      <figure class="abx__ph abx__ph--trail" style={at(397, 409, 311, 164)}><Image src={trail} alt="Two friends on a coastal trail above the ocean." {...shot} /></figure>
      <figure class="abx__ph abx__ph--group" style={at(397, 597, 311, 175)}><Image src={group} alt="A group of friends with snowboards on the mountain." {...shot} /></figure>
      <svg class="abx__marks" viewBox="0 4 1440 700" aria-hidden="true"><g transform="translate(-28 0)"><path class="s" d="M612 32 C 712 54, 772 204, 752 374 C 738 504, 820 608, 902 598 C 962 590, 952 526, 906 536 C 860 546, 878 674, 1004 804"/></g><path class="s" d="M418.9 299.2 A52 52 0 1 1 396.0 272.0"/><ellipse class="s" cx="617" cy="639" rx="133" ry="44" transform="rotate(-12 617 639)"/><circle cx="734" cy="616" r="3.5"/><g class="abx__light" transform="translate(-28 28)"><circle cx="503.3" cy="37.3" r="1.00"/><circle cx="445.5" cy="10.7" r="0.70"/><circle cx="602.0" cy="-2.3" r="1.14"/><circle cx="634.9" cy="24.8" r="1.27"/><circle cx="598.2" cy="31.6" r="1.34"/><path d="M554.3 9.3 l-2.7 -2.3" class="s"/><path d="M513.1 -9.8 l-3.1 -2.1" class="s"/><path d="M611.1 27.8 l0.4 -10.9" class="s"/><path d="M462.3 23.9 l-13.8 -3.1" class="s"/><path d="M579.4 22.2 l-7.9 -9.0" class="s"/><circle cx="683.2" cy="-1.7" r="1.01"/><path d="M614.7 44.3 l3.5 -9.5" class="s"/><path d="M468.3 30.4 l-9.7 -1.8" class="s"/><path d="M693.5 6.2 l11.6 -7.1" class="s"/><circle cx="609.4" cy="5.9" r="1.19"/><circle cx="451.2" cy="9.9" r="0.72"/><circle cx="525.0" cy="20.7" r="1.06"/><path d="M644.7 43.0 l13.1 -5.3" class="s"/><circle cx="692.0" cy="-18.5" r="0.91"/><circle cx="722.8" cy="-8.8" r="0.85"/><path d="M566.2 33.4 l-9.4 -5.1" class="s"/><path d="M583.5 34.7 l-9.1 -7.6" class="s"/><circle cx="608.6" cy="51.9" r="1.47"/><circle cx="488.3" cy="26.0" r="0.92"/><path d="M670.1 10.6 l10.4 -8.0" class="s"/><circle cx="498.9" cy="-11.8" r="0.84"/><circle cx="561.2" cy="13.1" r="1.15"/><circle cx="549.0" cy="-18.3" r="0.97"/><path d="M490.2 2.2 l-8.1 -3.7" class="s"/><path d="M618.3 8.1 l1.0 -6.0" class="s"/><circle cx="495.9" cy="8.8" r="0.90"/><path d="M521.9 -5.1 l-6.1 -4.3" class="s"/><circle cx="725.6" cy="-20.9" r="0.79"/><circle cx="570.6" cy="13.3" r="1.18"/><path d="M740.8 1.8 l7.5 -3.2" class="s"/><path d="M617.7 48.5 l7.1 -7.8" class="s"/><circle cx="452.6" cy="21.7" r="0.75"/><path d="M613.0 48.9 l3.9 -10.6" class="s"/><circle cx="671.6" cy="27.8" r="1.17"/><circle cx="762.0" cy="21.1" r="0.78"/><path d="M512.3 -7.2 l-11.2 -7.4" class="s"/><circle cx="592.4" cy="33.6" r="1.34"/><circle cx="767.8" cy="6.4" r="0.72"/><circle cx="703.2" cy="1.9" r="0.96"/><path d="M628.3 22.9 l2.9 -5.4" class="s"/><path d="M486.9 27.2 l-12.3 -3.0" class="s"/><circle cx="643.7" cy="25.6" r="1.26"/><path d="M474.3 2.4 l-7.2 -2.9" class="s"/><circle cx="584.1" cy="38.9" r="1.34"/><path d="M689.2 16.0 l7.6 -3.9" class="s"/><path d="M647.6 32.1 l3.1 -2.1" class="s"/><circle cx="616.7" cy="51.0" r="1.45"/><circle cx="609.9" cy="51.9" r="1.47"/><circle cx="605.1" cy="1.1" r="1.16"/><circle cx="639.7" cy="32.9" r="1.30"/><path d="M696.5 16.1 l6.7 -3.1" class="s"/><circle cx="544.5" cy="-13.4" r="0.98"/><circle cx="622.1" cy="23.9" r="1.29"/><circle cx="568.1" cy="39.4" r="1.28"/><path d="M463.9 -6.9 l-3.6 -1.6" class="s"/><path d="M607.4 -16.4 l-0.4 -10.8" class="s"/><path d="M474.9 -2.7 l-11.3 -5.0" class="s"/><circle cx="616.7" cy="24.2" r="1.30"/><path d="M745.9 20.1 l10.6 -2.9" class="s"/><path d="M556.6 -2.1 l-6.1 -6.7" class="s"/><path d="M556.3 -5.8 l-2.7 -3.2" class="s"/><circle cx="667.9" cy="5.0" r="1.09"/><circle cx="651.6" cy="42.3" r="1.29"/><circle cx="684.2" cy="1.5" r="1.02"/><circle cx="635.0" cy="41.3" r="1.35"/><circle cx="670.8" cy="30.9" r="1.18"/><circle cx="450.1" cy="2.1" r="0.70"/><circle cx="676.7" cy="1.4" r="1.05"/><path d="M615.1 47.2 l3.0 -5.8" class="s"/></g></svg>
      <div class="abx__text">
        <p style={`left:${776 / 14.4}%; top:${(128 - 100) / 7}%`}>I'm a designer and a senior at UC Davis, originally from San Francisco. I started out in Fine Arts, then moved into product design to make things people use every day. Right now I design for Moober and Buzzit, two live apps for Davis students.</p>
        <p style={`left:${850 / 14.4}%; top:${(337 - 100) / 7}%`}>When I'm not designing, I'm usually playing sports with friends or out looking for good food. I watch Tottenham, for better or worse, make music in FL Studio, and book trips on a whim, like Korea and Japan this summer.</p>
      </div>
    </div>
  </main>

  <Foot />
</Base>
