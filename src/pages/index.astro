---
import Base from '../layouts/Base.astro';
import { links } from '../data/site';
import Work from '../components/Work.astro';
import Foot from '../components/Foot.astro';
---
<Base>
  <!-- the first screen: the sunlight on the paper is the picture; the name and menu above it, the tagline low on the left -->
  <section class="first hero rel">
    <header class="hero__top grid">
      <a class="name enter" style="--i: 0" href="/">Ian Kim</a>
      <ul class="menu hero__menu enter" style="--i: 1">
        <li><a href="/" aria-current="page">Work</a></li><li><a href="/about">About</a></li><li><a href={links.resume} target="_blank" rel="noopener">Resume</a></li>
      </ul>
    </header>
    <div class="grid hero__statement">
      <h1 class="words" style="--wd: 450ms">Designer with an artist's eye for detail</h1>
    </div>
  </section>
  <main>
    <Work />
  </main>
  <Foot />
</Base>
