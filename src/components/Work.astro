---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
// the work, composed on one page like a spread in a printed book: the projects at different sizes and heights,
// each with its short text directly beneath it, and quiet running labels at the top of the page.
// The first sits large and low on the left, the second smaller and high on the right.
const places = ['spread__piece--a', 'spread__piece--b'];
---
<section class="work" id="work" aria-labelledby="work-title">
  <canvas class="spill spill--quiet-l" data-aspect="1.25" data-origin="0.45 0.45" data-seed="5" data-strength="0.6" aria-hidden="true"></canvas>
  <div class="spread grid">
    <p id="work-title" class="spread__run spread__run--l">Selected work</p>
    <p class="spread__run spread__run--r">2026</p>
    {projects.map((p, i) => (
      <article class={`spread__piece ${places[i % places.length]} reveal`} style={`--i: ${i}`}>
        <a class="wcard__cover" href={p.href} data-slug={p.slug} tabindex="-1" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
          <Image src={p.cover} alt={p.alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 56vw, 100vw" quality={86} loading={i === 0 ? 'eager' : 'lazy'} />
        </a>
        <div class="spread__text">
          <h3 class="spread__title">{p.title}</h3>
          <p class="spread__body">{p.blurb}</p>
          <a class="spread__link" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>Read the case study <span class="arrow">&rarr;&#65038;</span></a>
        </div>
      </article>
    ))}
  </div>
  <canvas class="spill spill--quiet-r" data-aspect="1.1" data-origin="0.55 0.5" data-seed="11" data-strength="0.55" aria-hidden="true"></canvas>
</section>
