---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---
<!-- the work, side by side, right under the opening: each project is its cover with its name and one line under it.
     The cover carries the project into its case study (see transition.js); the watercolor marks bloom in the margins. -->
<section class="work" aria-labelledby="work-title">
  <canvas class="spill spill--quiet-l" data-aspect="1.25" data-origin="0.45 0.45" data-seed="5" data-strength="0.6" aria-hidden="true"></canvas>
  <h2 id="work-title" class="sr-only">Selected work</h2>
  <ul class="work__cards grid">
    {projects.map((p, i) => (
      <li class="wcard reveal" style={`--i: ${i}`}>
        <a class="wcard__link" href={p.href} aria-disabled={p.soon ? 'true' : undefined}>
          <span class="wcard__cover" data-slug={p.slug} data-soon={p.soon ? '' : undefined}>
            <Image src={p.cover} alt={p.alt} widths={[640, 960, 1280, 1600, p.cover.width]} sizes="(min-width: 768px) 46vw, 100vw" quality={86} loading={i === 0 ? 'eager' : 'lazy'} />
          </span>
          <span class="wcard__info">
            <span class="wcard__title">{p.title}</span>
            <span class="wcard__line">{p.summary}</span>
            <span class="wcard__go arrow" aria-hidden="true">&rarr;&#65038;</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <canvas class="spill spill--quiet-r" data-aspect="1.1" data-origin="0.55 0.5" data-seed="11" data-strength="0.55" aria-hidden="true"></canvas>
</section>
