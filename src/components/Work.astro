---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
// the work, side by side: each cover is Ian's own, toned toward the paper; under the pointer its full colour comes
// back as it leans in a little. Under each, the name and kind on one line (the kind in grey) and one short grey line.
// On phones they stack.
---
<section class="work" id="work" aria-labelledby="work-title">
  <div class="grid wg">
    <p id="work-title" class="label wg__head">Selected work</p>
    <div class="wg__list">
    {projects.map((p, i) => (
      <a class="wg__item reveal" style={`--i: ${i}`} href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
        <span class="wcard__cover wg__plate" data-slug={p.slug} role="img" aria-label={p.alt}>
          <Image class="wg__img" src={p.cover} alt="" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 40vw, (min-width: 768px) 46vw, 100vw" quality={86} loading={i === 0 ? 'eager' : 'lazy'} />
          {p.coverFull && <Image class="wg__img wg__img--full" src={p.coverFull} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 40vw, 46vw" quality={86} loading="lazy" />}
        </span>
        <span class="wg__line"><span class="wg__title">{p.title}</span><span class="wg__meta" aria-hidden="true">/</span><span class="wg__meta">{p.meta[1]}, {p.year}</span></span>
        <span class="wg__sum">{p.summary}</span>
      </a>
    ))}
    </div>
  </div>
</section>
